<Application x:Class="GlassIsland.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFF4F6FB" />
        <SolidColorBrush x:Key="TextSecondary" Color="#FF9CA5B5" />
        <SolidColorBrush x:Key="Accent" Color="#FFB6A4FF" />
        <SolidColorBrush x:Key="PanelBackground" Color="#FF171B25" />
    </Application.Resources>
</Application>
